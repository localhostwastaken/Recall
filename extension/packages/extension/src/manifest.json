{
  "manifest_version": 3,
  "version": "0.1.0.1501",
  "name": "Recall",
  "description": "Capture a public web page with a witness signature. Evidence goes to Swarm; the index goes to Arkiv.",
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall",
    "default_icon": {
      "34": "icon-34.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://localhostwastaken.github.io/*",
      "https://*.bzz.link/*",
      "http://localhost:1633/*"
    ]
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["offscreen", "storage", "tabs", "activeTab"]
}
