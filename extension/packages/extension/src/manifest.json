{
  "manifest_version": 3,
  "version": "0.1.0.1501",
  "name": "Recall",
  "description": "Capture a public web page with a witness signature. Evidence goes to Swarm; the index goes to Arkiv.",
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://localhostwastaken.github.io/*",
      "https://*.bzz.link/*",
      "http://localhost:1633/*"
    ]
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.trycloudflare.com/*",
    "https://api.gateway.ethswarm.org/*",
    "https://download.gateway.ethswarm.org/*",
    "https://bzz.link/*",
    "https://*.bzz.link/*",
    "https://rpc.rabdi.db-chain.testnet.arkiv.network/*",
    "https://rpc.gnosischain.com/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["offscreen", "storage", "tabs", "activeTab"]
}
